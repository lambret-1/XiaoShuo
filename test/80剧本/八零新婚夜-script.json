          "flow": [
            {
              "action": "冷。桥洞底下大雪纷飞，苏晚缩在破草席里，浑身发紫，眼前一黑。"
            },
            {
              "action": "猛地睁眼。黄泥墙，土炕，煤油灯——她回到了八零年代的家。"
            },
            {
              "speaker": "C06",
              "line": "妈妈……饿……",
              "delivery": "细细的压抑哭声，像小猫"
            },
            {
              "action": "苏晚偏头，看见炕角缩成一团瘦得像小猫的女儿小宝。"
            },
            {
              "action": "脑海里叮的一声。空间激活——黑土地、清泉、三间仓库。"
            },
            {
              "speaker": "C01",
              "line": "这一世，谁也别想再欺负我的孩子。",
              "delivery": "眼泪砸在被面上，声音冷下来"
            },
            {
              "action": "门吱呀推开。陆野端着粗瓷碗进来，肩上落着薄雪。"
            },
            {
              "speaker": "C02",
              "line": "醒了？冷不冷？红薯在锅里温着。",
              "delivery": "沙哑低沉，小心翼翼，手在棉袄上蹭了蹭"
            },
            {
              "action": "苏晚看着那双布满老茧和伤疤的大手，看着他黝黑紧绷的脸。"
            },
            {
              "speaker": "C01",
              "line": "……放这儿吧，我饿了。",
              "delivery": "轻声，压着哽咽"
            },
            {
              "action": "陆野愣住，漆黑眸子里闪过意外，转身出去。"
            },
            {
              "action": "苏晚掰了一半红薯，小心翼翼递到小宝嘴边。小宝一口咬住。"
            },
            {
              "action": "眼泪无声落下。她看着炕沿冒热气的红薯和炕上的一双儿女。"
            },
            {
              "action": "苏晚低头看自己粗糙的手——不是临死桥洞那双冻紫的手。"
            },
            {
              "action": "她攥紧被角，指节发白。"
            },
            {
              "action": "小宝咬了一口红薯，烫得缩了一下脖子，又接着咬。"
            },
            {
              "action": "陆野站在门口没敢往里走，大手在棉袄上蹭了蹭。"
            },
            {
              "action": "苏晚掰红薯时，手在抖。"
            },
            {
              "action": "小宝咬红薯的小嘴上沾了薯泥。"
            },
            {
              "action": "苏晚深吸一口气。"
            },
            {
              "action": "（静默一拍）"
            }
          ]
        }
      ]
